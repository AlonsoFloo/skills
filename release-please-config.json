{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    {
      "type": "sentence-case"
    }
  ],
  "include-commit-authors": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "always-update": true,
      "extra-files": [
        {
          "type": "generic",
          "path": "apm.yml"
        },
        {
          "type": "generic",
          "path": "README.md"
        }
      ]
    }
  }
}
