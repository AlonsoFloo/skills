{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Loading caveman mode...",
            "command": "node \".gemini/hooks/caveman/src/hooks/caveman-activate.js\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Tracking caveman mode...",
            "command": "node \".gemini/hooks/caveman/src/hooks/caveman-mode-tracker.js\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
